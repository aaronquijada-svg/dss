# Supported values: mock, safesign
SFE_SIGN_SIGNING_PROVIDER=mock

# Configure only in a secured deployment. Never put a PIN, private key, or certificate here.
# SFE_SIGN_PKCS11_LIBRARY_PATH=C:\Windows\System32\aetpkss1.dll

# Configure only an approved HTTP(S) TSA URL through deployment secrets/configuration.
# Credentials and URI fragments are rejected. No request is made in this starter.
# SFE_SIGN_TSA_URL=

# The local agent prints fresh values when it starts. Never commit the session secret.
# SFE_SIGN_AGENT_URL=http://127.0.0.1:<agent-port>
# SFE_SIGN_AGENT_SESSION_SECRET=
